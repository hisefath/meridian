# Copy to .env and fill in. Never commit .env or anything in keys/.

# ---- cluster
RPC_URL=https://api.devnet.solana.com

# ---- keys: a file path or an inline JSON array secret key
ADMIN_KEYPAIR=keys/admin.json
USDC_MINT_KEYPAIR=keys/usdc-mint.json
MM_KEYPAIR=keys/mm.json
TRADER_KEYPAIR=keys/trader.json

# ---- collateral: devnet test-USDC mint created by `make setup-devnet` (mint authority = admin)
USDC_MINT=Hfc3dPjuECg2n6qk3b8C4G2J2GeMnxKM7KAJ4zzCV4Qg

# ---- oracle (Pyth). Hermes requires an API key since 2026-08-26: https://pythdata.app/signup
PYTH_API_KEY=
HERMES_URL=https://pyth.dourolabs.app/hermes
MAX_STALENESS_SECS=300
MAX_CONF_BPS=200
OVERRIDE_DELAY_SECS=900

# ---- automation
MORNING_ET=08:00
STRIKE_PCTS=3,6,9
INCLUDE_ATM=true
# Fallback previous closes (USD) used only when PYTH_API_KEY is empty, e.g. AAPL=230,META=680
PREV_CLOSES=
SETTLE_RETRY_WINDOW_SECS=900
# Optional Slack/Discord-compatible webhook for warn/error alerts
ALERT_WEBHOOK_URL=

# ---- lifecycle script
TICKER=META
CLOSE_IN_MINUTES=3
STRIKE=
OVERRIDE_PRICE=

# ---- frontend (Next.js reads NEXT_PUBLIC_* in the browser)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_USDC_MINT=Hfc3dPjuECg2n6qk3b8C4G2J2GeMnxKM7KAJ4zzCV4Qg
# server-side only: faucet signer (test-USDC mint authority) and Hermes proxy key
FAUCET_KEYPAIR=keys/admin.json
